    {
        "id": "b8725497e0eb61b2",
        "type": "function",
        "z": "31d72a7fa31115e4",
        "name": "Weather Data Simulator",
        "func": "let temp = Math.floor(Math.random() * 21) + 20;\nlet hum = Math.floor(Math.random() * 101);\n\nlet weather;\n\nif (temp >= 30) {\n    weather = \"Sunny\";\n}\nelse if (temp >= 20) {\n    weather = \"Cloudy\";\n}\nelse {\n    weather = \"Rainy\";\n}\n\nmsg.payload = {\n    temperature: temp,\n    humidity: hum,\n    status: weather\n};\n\nreturn msg;",
